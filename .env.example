# =============================================================================
# EXAMSOLOT ENVIRONMENT CONFIGURATION
# Copy to .env for local development / hosting setup
# =============================================================================

# Application Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (SQLite / PostgreSQL / MySQL)
# For SQLite (local dev): file:./db/examslot.db
# For PostgreSQL (production): postgresql://user:password@localhost:5432/examslot_db
DATABASE_URL=file:./db/examslot.db

# Authentication / Security Secrets
JWT_SECRET=super_secret_jwt_key_examslot_2026_loopverse
JWT_EXPIRES_IN=60m
REFRESH_TOKEN_EXPIRES_IN=7d

# Password Setup & Reset Token TTL (Hours)
SETUP_TOKEN_TTL_HOURS=24

# Mailer Configuration (Mailtrap / SMTP / Gmail App Password / Resend)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
MAIL_FROM="ExamSlot System <noreply@examslot.test>"

# Initial Seed Credentials (Used by seed scripts)
ADMIN_SEED_EMAIL=admin@examslot.test
ADMIN_SEED_PASSWORD=AdminPassword123!
